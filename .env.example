# =========================================================
# Navalha — Variáveis de Ambiente
# Copie este arquivo para ".env" na raiz do projeto e
# preencha com valores reais. NUNCA versione o ".env".
# =========================================================

# ---- Spring Boot -----------------------------------------
# Perfil ativo do Spring (ex: prod, dev)
SPRING_PROFILES_ACTIVE=prod

# ---- PostgreSQL --------------------------------------------
# Nome do banco criado pelo container postgres (POSTGRES_DB)
POSTGRES_DB=alabama_barbers_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# URL JDBC usada pelo backend para conectar ao container postgres.
# O host "postgres" é o nome do serviço no docker-compose.yml.
DATABASE_URL=jdbc:postgresql://postgres:5432/alabama_barbers_db

# ---- Segurança / JWT ----------------------------------------
# Segredo usado para assinar os tokens JWT (HMAC256).
# Gere um valor aleatório forte, ex: openssl rand -base64 64
JWT_SECRET=generate-a-secret
